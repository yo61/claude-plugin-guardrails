{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/bash-guard.sh\"",
            "shell": "bash",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/git-rebase-gate.sh\"",
            "shell": "bash",
            "timeout": 25
          }
        ]
      }
    ]
  }
}
